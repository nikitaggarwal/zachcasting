# Copy to .env.local and fill in. Never commit real keys.

# YouTube Data API v3 — commentThreads.list + videos.list
YOUTUBE_API_KEY=

# Anthropic — model id is set in lib/claude-analyze.ts
ANTHROPIC_API_KEY=

# ── Live Channel Pulse + roster (homepage) ─────────────────────────
# Needs YouTube API key, Anthropic key, and UC… channel id below.
# Cast names for Claude are loaded automatically: everyone found in saved analyses,
# or a small built‑in seed on first run—no list required in env.
#
# YouTube channel id is the UC… value (Share → Copy channel ID on desktop).

YOUTUBE_CHANNEL_ID=
# Optional manual override only — comma‑separated cast names for Claude. Leave blank to
# discover names from persisted analyses (recommended).
#CHANNEL_CAST_NAMES=
# Optional. Display name for the channel owner; roster shows them above ranked cast.
# Defaults to the first built‑in seed name ("Zach Justice") unless you override.
#CHANNEL_HOST_NAME=Zach Justice

# Optional: directory for SQLite (default ./data locally, /tmp/zachcasting-data on Vercel).
# On Vercel, /tmp is writable; local persistent DB would need a hosted SQL store.
#DATA_DIR=/tmp/zachcasting-data

# Optional (defaults):
# How many newest uploads pulse considers per run (home background + /pulse). Default 20; max 48.
#CHANNEL_PULSE_MAX_VIDEOS=20
#CHANNEL_PULSE_MAX_COMMENTS=350
#CHANNEL_PULSE_REVALIDATE_SECONDS=3600

# Optional — backfill API only (non‑Vercel). Raises how many *unseen* uploads one POST can analyze.
#CHANNEL_BACKFILL_DEFAULT_MAX_VIDEOS=50
#CHANNEL_BACKFILL_MAX_VIDEOS_HARD_CAP=80
#CHANNEL_BACKFILL_DEFAULT_PLAYLIST_SCAN=500
#CHANNEL_BACKFILL_PLAYLIST_SCAN_HARD_CAP=800
