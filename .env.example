# Copy to .env.local and fill in. Never commit real keys.

# YouTube Data API v3 — commentThreads.list + videos.list
YOUTUBE_API_KEY=

# Anthropic — model id is set in lib/claude-analyze.ts
ANTHROPIC_API_KEY=

# ── Live Channel Pulse (homepage) ───────────────────────────────────
# Needs YouTube API key, Anthropic key, and UC… channel id below. Optional:
# CHANNEL_CAST_NAMES (defaults live in lib/channel-cast-defaults.ts if you leave it blank).
# Pulse pulls recent uploads, scores comments; if keys or channel id are missing, homepage
# stays on built-in demo data.
#
# YouTube channel id is the UC… value (Share → Copy channel ID on desktop).

YOUTUBE_CHANNEL_ID=
# Comma-separated. If omitted, defaults in lib/channel-cast-defaults.ts are used.
CHANNEL_CAST_NAMES=

# Optional: directory for SQLite (default ./data locally, /tmp/zachcasting-data on Vercel).
# On Vercel, /tmp is writable; local persistent DB would need a hosted SQL store.
#DATA_DIR=/tmp/zachcasting-data

# Optional (defaults):
#CHANNEL_PULSE_MAX_VIDEOS=10
#CHANNEL_PULSE_MAX_COMMENTS=350
#CHANNEL_PULSE_REVALIDATE_SECONDS=3600
